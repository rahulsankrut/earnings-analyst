# ── Company Profile ─────────────────────────────────────────────────────────
# Selects which company the agents analyse. Must match a filename in
# company_profiles/data/ (without .json). Ships with: alphabet, example.
# To onboard a new company, copy company_profiles/data/example.json,
# fill in the competitors and their reporting segments, and name it here.
# Defaults to "example" if unset — set this before deploying.
COMPANY_PROFILE=alphabet

# ── Google Cloud Project ────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=1

# ── Agent Engine Deployment ─────────────────────────────────────────────────
# Staging buckets used by Agent Engine during deployment (must exist, one per agent)
GOOGLE_CLOUD_STORAGE_BUCKET=your-phoenix-staging-bucket
IE_STAGING_BUCKET=your-ie-staging-bucket
AGENT_SERVICE_ACCOUNT=your-sa@your-project.iam.gserviceaccount.com

# ── Vertex AI Search Data Stores ────────────────────────────────────────────
EARNINGS_DATA_STORE_ID=your-earnings-datastore-id
COMPETITOR_DATA_STORE_ID=your-competitor-datastore-id
DATA_STORE_LOCATION=global

# Search engines (apps) over the data stores. Strongly recommended: extractive
# answers/segments and the page numbers used in citations are Enterprise-edition
# features that can only be enabled at the engine level. Querying a bare data
# store returns document titles and links but no usable text.
# Leave blank to fall back to the data store (snippets only).
EARNINGS_SEARCH_ENGINE_ID=your-earnings-search-engine-id
COMPETITOR_SEARCH_ENGINE_ID=your-competitor-search-engine-id

# ── GCS Buckets ─────────────────────────────────────────────────────────────
# Bucket where extracted intelligence reports are stored and read by Phoenix
INTELLIGENCE_BUCKET=your-intelligence-bucket
# Bucket holding source PDF documents for Vertex AI Search ingestion
DOCUMENT_BUCKET=your-document-bucket
# Filename substring to skip when uploading documents (leave blank to upload all)
SKIP_PATTERN=

# ── Models ───────────────────────────────────────────────────────────────────
# Region serving the models. gemini-3.5/3.6-flash are global-only:
# they appear in a region's model list but 404 on an actual call there.
MODEL_LOCATION=global
PHOENIX_MODEL=gemini-3.6-flash
PHOENIX_FLASH_MODEL=gemini-3.6-flash

# ── SDK / Auth ───────────────────────────────────────────────────────────────
CLOUDSDK_CONTEXT_AWARE_USE_CLIENT_CERTIFICATE=false
